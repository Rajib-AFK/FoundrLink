<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="User.master.cs" Inherits="FoundrLink.UserMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - FoundrLink</title>
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/foundrlink.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server" class="fl-app-wrapper" enctype="multipart/form-data">
        <asp:ScriptManager runat="server" EnableCdn="false" />

        <!-- Left Sidebar Navigation -->
        <aside class="fl-sidebar" id="flSidebar">
            <div>
                <!-- Brand Header -->
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <a class="fl-brand p-0" runat="server" href="~/Dashboard.aspx">
                        <div class="fl-brand-logo" style="width: 36px; height: 36px; background: #0F172A; border-radius: 9px;">
                            <i class="bi bi-hexagon-fill" style="color: #6DF5E1; font-size: 1.15rem;"></i>
                        </div>
                        <div>
                            <h1 class="fl-brand-title">FoundrLink</h1>
                            <p class="fl-brand-subtitle">Founder Discovery</p>
                        </div>
                    </a>
                    <button type="button" class="btn-close d-lg-none" id="btnSidebarClose" aria-label="Close navigation"></button>
                </div>

                <!-- Primary Navigation -->
                <ul class="fl-nav-list mt-3">
                    <li class="fl-nav-item">
                        <a id="navDashboard" runat="server" href="~/Dashboard.aspx" class="fl-nav-link">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navDiscover" runat="server" href="~/ExploreStartups.aspx" class="fl-nav-link">
                            <i class="bi bi-search"></i>
                            <span>Discover</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navFounders" runat="server" href="~/FindCoFounders.aspx" class="fl-nav-link">
                            <i class="bi bi-people-fill"></i>
                            <span>Founders</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navStartups" runat="server" href="~/MyStartups.aspx" class="fl-nav-link">
                            <i class="bi bi-briefcase-fill"></i>
                            <span>Startups</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Sidebar Footer -->
            <div class="fl-sidebar-footer">
                <ul class="fl-nav-list">
                    <li class="fl-nav-item">
                        <a id="navSettings" runat="server" href="~/Settings.aspx" class="fl-nav-link">
                            <i class="bi bi-gear"></i>
                            <span>Settings</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navSupport" runat="server" href="~/Support.aspx" class="fl-nav-link">
                            <i class="bi bi-question-circle"></i>
                            <span>Support</span>
                        </a>
                    </li>
                </ul>

                <!-- User Profile Badge at bottom -->
                <div class="fl-user-badge d-flex align-items-center justify-content-between">
                    <a runat="server" href="~/Profile.aspx" class="d-flex align-items-center gap-2 text-decoration-none text-dark flex-grow-1 overflow-hidden">
                        <asp:Image ID="imgSidebarAvatar" runat="server" CssClass="fl-avatar-sm" ImageUrl="~/Images/default-avatar.png" />
                        <div class="overflow-hidden">
                            <div class="fw-bold text-truncate small">
                                <asp:Literal ID="litSidebarUserName" runat="server" Mode="Encode" Text="Founder User" />
                            </div>
                            <div class="text-muted small" style="font-size: 0.72rem;">
                                <asp:Literal ID="litSidebarUserRole" runat="server" Mode="Encode" Text="Founder" />
                            </div>
                        </div>
                    </a>
                    <asp:LinkButton ID="btnSidebarLogout" runat="server" CssClass="text-secondary p-1" OnClick="btnSidebarLogout_Click" ToolTip="Log out">
                        <i class="bi bi-box-arrow-right"></i>
                    </asp:LinkButton>
                </div>
            </div>
        </aside>

        <!-- Mobile Sidebar Backdrop Overlay -->
        <div class="fl-sidebar-backdrop d-lg-none" id="flSidebarBackdrop"></div>

        <!-- Main Content Area -->
        <div class="fl-main-area">
            <!-- Topbar Header -->
            <header class="fl-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-link fl-mobile-nav-toggle d-lg-none p-1 text-dark" id="btnSidebarToggle" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-2 lh-1"></i>
                    </button>
                    <div class="fl-search-box">
                        <i class="bi bi-search"></i>
                        <asp:TextBox ID="txtSearch" runat="server" placeholder="Search platform..." OnTextChanged="txtSearch_TextChanged" AutoPostBack="true" />
                    </div>
                </div>

                <div class="fl-topbar-actions">
                    <!-- Notifications -->
                    <a runat="server" href="~/Notifications.aspx" class="fl-icon-btn" title="Notifications">
                        <i class="bi bi-bell fs-5"></i>
                        <asp:Panel ID="pnlUnreadNotif" runat="server" CssClass="fl-unread-dot" Visible="false" />
                    </a>

                    <!-- Messages -->
                    <a runat="server" href="~/Messages.aspx" class="fl-icon-btn" title="Messages">
                        <i class="bi bi-chat-left-text fs-5"></i>
                        <asp:Panel ID="pnlUnreadMsg" runat="server" CssClass="fl-unread-dot" Visible="false" />
                    </a>

                    <!-- Create Startup Button -->
                    <a runat="server" href="~/ManageStartup.aspx" class="btn-fl-dark text-nowrap d-flex align-items-center gap-1" style="height: 38px; padding: 0 14px; font-size: 0.85rem;" title="Create Startup">
                        <i class="bi bi-plus-lg"></i>
                        <span class="d-none d-sm-inline">Create Startup</span>
                    </a>

                    <!-- User Profile Avatar -->
                    <a runat="server" href="~/Profile.aspx" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                        <asp:Image ID="imgTopbarAvatar" runat="server" CssClass="fl-avatar-sm" ImageUrl="~/Images/default-avatar.png" />
                        <div class="d-none d-md-block text-start">
                            <div class="fw-bold small lh-1">
                                <asp:Literal ID="litTopbarUserName" runat="server" Mode="Encode" Text="Founder User" />
                            </div>
                            <small class="text-muted" style="font-size: 0.7rem;">
                                <asp:Literal ID="litTopbarRole" runat="server" Mode="Encode" Text="Entrepreneur" />
                            </small>
                        </div>
                    </a>
                </div>
            </header>

            <!-- Page Body Content -->
            <main class="fl-content-container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if (typeof bootstrap === 'undefined') {
            document.write('<script src="<%= ResolveClientUrl("~/Scripts/bootstrap.bundle.min.js") %>"><\/script>');
        }
    </script>
    <script src='<%= ResolveClientUrl("~/Scripts/chart.umd.min.js") %>'></script>
    <script>
        (function () {
            var sidebar = document.getElementById('flSidebar');
            var toggleBtn = document.getElementById('btnSidebarToggle');
            var closeBtn = document.getElementById('btnSidebarClose');
            var backdrop = document.getElementById('flSidebarBackdrop');

            function openSidebar() {
                if (sidebar) sidebar.classList.add('show');
                if (backdrop) backdrop.classList.add('show');
                document.body.classList.add('fl-sidebar-open');
            }

            function closeSidebar() {
                if (sidebar) sidebar.classList.remove('show');
                if (backdrop) backdrop.classList.remove('show');
                document.body.classList.remove('fl-sidebar-open');
            }

            if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
            if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
            if (backdrop) backdrop.addEventListener('click', closeSidebar);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && sidebar && sidebar.classList.contains('show')) {
                    closeSidebar();
                }
            });

            if (sidebar) {
                sidebar.querySelectorAll('.fl-nav-link').forEach(function (link) {
                    link.addEventListener('click', function () {
                        if (window.innerWidth < 992) {
                            closeSidebar();
                        }
                    });
                });
            }

            // Ensure clicking the label cleanly toggles ASP.NET rendered checkboxes and radio buttons
            document.addEventListener('click', function (e) {
                var label = e.target.closest('.form-check-label');
                if (label) {
                    var container = label.closest('.form-check');
                    if (container) {
                        var input = container.querySelector('input[type="radio"], input[type="checkbox"]');
                        if (input && e.target !== input) {
                            input.click();
                        }
                    }
                }
            });
        })();
    </script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
