<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="FoundrLink.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - FoundrLink</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/foundrlink.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="d-flex flex-column min-vh-100 bg-white">
    <form runat="server" class="d-flex flex-column flex-grow-1">
        <asp:ScriptManager runat="server" EnableCdn="false" />

        <!-- Public Top Navigation -->
        <header class="navbar navbar-expand-lg navbar-dark bg-black py-3 border-bottom border-dark sticky-top" style="border-color: #1A1A1A !important;">
            <div class="container" style="max-width: 1200px;">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 text-white" runat="server" href="~/">
                    <div class="fl-brand-logo" style="width: 32px; height: 32px; background: #0284C7; border-radius: 7px; color: #FFFFFF; font-size: 16px;">
                        <i class="bi bi-diagram-3-fill"></i>
                    </div>
                    <span style="letter-spacing: -0.03em;">FoundrLink</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="publicNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-4">
                        <li class="nav-item">
                            <a class="nav-link text-light text-opacity-75 small fw-semibold" runat="server" href="~/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light text-opacity-75 small fw-semibold" runat="server" href="~/ExploreStartups.aspx">Explore Startups</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light text-opacity-75 small fw-semibold" runat="server" href="~/FindCoFounders.aspx">Find Co-Founders</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <asp:PlaceHolder ID="phAnonymous" runat="server">
                            <a class="nav-link text-white fw-semibold small px-2" runat="server" href="~/Login.aspx">Log In</a>
                            <a class="btn btn-outline-light btn-sm px-4 fw-semibold rounded-pill" runat="server" href="~/Register.aspx" style="border-color: rgba(255,255,255,0.3);">Join Free</a>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phLoggedIn" runat="server" Visible="false">
                            <a class="btn btn-sm px-3 fw-semibold text-white" runat="server" href="~/Dashboard.aspx" style="background:#006591; border-radius:6px;">Go to Dashboard</a>
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-light btn-sm" OnClick="btnLogout_Click">Logout</asp:LinkButton>
                        </asp:PlaceHolder>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Public Footer -->
        <footer class="bg-black text-white py-5 border-top border-dark mt-auto" style="border-color: #1A1A1A !important;">
            <div class="container" style="max-width: 1200px;">
                <div class="row g-4 justify-content-between mb-5">
                    <div class="col-lg-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="fl-brand-logo" style="width: 28px; height: 28px; background: #FFFFFF; border-radius: 6px; color: #000000; font-size: 14px;">
                                <i class="bi bi-diagram-3-fill"></i>
                            </div>
                            <span class="fw-bold fs-5 text-white" style="letter-spacing: -0.02em;">FoundrLink</span>
                        </div>
                        <p class="small mb-0 pe-lg-4" style="color: #94A3B8; line-height: 1.6;">
                            Engineering serendipity for the top percentile of global builders and backers.
                        </p>
                    </div>

                    <div class="col-6 col-md-2">
                        <h6 class="fw-bold text-uppercase mb-3 text-white" style="font-size: 0.75rem; letter-spacing: 0.08em;">PLATFORM</h6>
                        <ul class="list-unstyled small d-flex flex-column gap-2" style="color: #94A3B8;">
                            <li><a href="ExploreStartups.aspx" class="text-decoration-none" style="color: #94A3B8;">For Founders</a></li>
                            <li><a href="ExploreStartups.aspx" class="text-decoration-none" style="color: #94A3B8;">For Investors</a></li>
                            <li><a href="FindCoFounders.aspx" class="text-decoration-none" style="color: #94A3B8;">Matching Algorithm</a></li>
                            <li><a href="ExploreStartups.aspx" class="text-decoration-none" style="color: #94A3B8;">Pricing</a></li>
                        </ul>
                    </div>

                    <div class="col-6 col-md-2">
                        <h6 class="fw-bold text-uppercase mb-3 text-white" style="font-size: 0.75rem; letter-spacing: 0.08em;">RESOURCES</h6>
                        <ul class="list-unstyled small d-flex flex-column gap-2" style="color: #94A3B8;">
                            <li><a href="#" class="text-decoration-none" style="color: #94A3B8;">Deal Flow Reports</a></li>
                            <li><a href="#" class="text-decoration-none" style="color: #94A3B8;">Term Sheet Templates</a></li>
                            <li><a href="#" class="text-decoration-none" style="color: #94A3B8;">Due Diligence Checklist</a></li>
                            <li><a href="#" class="text-decoration-none" style="color: #94A3B8;">Success Stories</a></li>
                        </ul>
                    </div>

                    <div class="col-6 col-md-2">
                        <h6 class="fw-bold text-uppercase mb-3 text-white" style="font-size: 0.75rem; letter-spacing: 0.08em;">COMPANY</h6>
                        <ul class="list-unstyled small d-flex flex-column gap-2" style="color: #94A3B8;">
                            <li><a href="#" class="text-decoration-none" style="color: #94A3B8;">About Us</a></li>
                            <li><a href="#" class="text-decoration-none" style="color: #94A3B8;">Careers</a></li>
                            <li><a href="#" class="text-decoration-none" style="color: #94A3B8;">Privacy Policy</a></li>
                            <li><a href="#" class="text-decoration-none" style="color: #94A3B8;">Terms of Service</a></li>
                        </ul>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center pt-4 border-top text-secondary small" style="border-color: #1F2937 !important; color: #64748B !important;">
                    <p class="mb-0">&copy; 2024 FoundrLink Inc. All rights reserved.</p>
                    <div class="d-flex gap-3 fs-6">
                        <a href="#" class="text-secondary"><i class="bi bi-share"></i></a>
                        <a href="#" class="text-secondary"><i class="bi bi-envelope"></i></a>
                    </div>
                </div>
            </div>
        </footer>
    </form>

    <script src='<%= ResolveClientUrl("~/Scripts/bootstrap.bundle.min.js") %>'></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
