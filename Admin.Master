<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="FoundrLink.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - FoundrLink Admin Console</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/foundrlink.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server" class="fl-app-wrapper">
        <asp:ScriptManager runat="server" EnableCdn="false" />

        <!-- Admin Sidebar -->
        <aside class="fl-sidebar">
            <div>
                <a class="fl-brand" runat="server" href="~/Admin/Dashboard.aspx">
                    <div class="fl-brand-logo bg-dark text-teal">
                        <i class="bi bi-hexagon-fill"></i>
                    </div>
                    <div>
                        <h1 class="fl-brand-title">FoundrLink</h1>
                        <p class="fl-brand-subtitle">Admin Console</p>
                    </div>
                </a>

                <ul class="fl-nav-list mt-3">
                    <li class="fl-nav-item">
                        <a id="navAdminDash" runat="server" href="~/Admin/Dashboard.aspx" class="fl-nav-link">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navAdminUsers" runat="server" href="~/Admin/ManageUsers.aspx" class="fl-nav-link">
                            <i class="bi bi-people-fill"></i>
                            <span>Founders</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navAdminStartups" runat="server" href="~/Admin/ManageStartups.aspx" class="fl-nav-link">
                            <i class="bi bi-briefcase-fill"></i>
                            <span>Startups</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navAdminReports" runat="server" href="~/Admin/Reports.aspx" class="fl-nav-link">
                            <i class="bi bi-flag-fill"></i>
                            <span>Reports & Categories</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Admin Sidebar Footer -->
            <div class="fl-sidebar-footer">
                <ul class="fl-nav-list">
                    <li class="fl-nav-item">
                        <a id="navAdminSettings" runat="server" href="~/Settings.aspx" class="fl-nav-link">
                            <i class="bi bi-gear"></i>
                            <span>Settings</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navAdminSupport" runat="server" href="~/Support.aspx" class="fl-nav-link">
                            <i class="bi bi-question-circle"></i>
                            <span>Support</span>
                        </a>
                    </li>
                </ul>

                <div class="fl-user-badge d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                        <asp:Image ID="imgAdminAvatar" runat="server" CssClass="fl-avatar-sm" ImageUrl="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&auto=format&fit=crop&q=80" />
                        <div class="overflow-hidden">
                            <div class="fw-bold text-truncate small">
                                <asp:Literal ID="litAdminName" runat="server" Text="System Admin" />
                            </div>
                            <div class="text-muted small" style="font-size: 0.72rem;">Admin Console</div>
                        </div>
                    </div>
                    <asp:LinkButton ID="btnAdminLogout" runat="server" CssClass="text-secondary p-1" OnClick="btnAdminLogout_Click" ToolTip="Log out">
                        <i class="bi bi-box-arrow-right"></i>
                    </asp:LinkButton>
                </div>
            </div>
        </aside>

        <!-- Admin Main Content -->
        <div class="fl-main-area">
            <header class="fl-topbar">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25 rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> System Status: Optimal
                    </span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a runat="server" href="~/Dashboard.aspx" class="btn btn-sm btn-fl-outline">
                        <i class="bi bi-arrow-up-right"></i> Switch to Founder View
                    </a>
                    <div class="d-flex align-items-center gap-2">
                        <asp:Image ID="imgAdminTopAvatar" runat="server" CssClass="fl-avatar-sm" ImageUrl="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&auto=format&fit=crop&q=80" />
                        <span class="fw-bold small d-none d-md-inline">
                            <asp:Literal ID="litAdminTopName" runat="server" Text="System Admin" />
                        </span>
                    </div>
                </div>
            </header>

            <main class="fl-content-container">
                <asp:ContentPlaceHolder ID="AdminContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>
    </form>

    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/chart.umd.min.js"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
