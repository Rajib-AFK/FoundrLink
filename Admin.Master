<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="FoundrLink.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - FoundrLink Admin Console</title>
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/foundrlink.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server" class="fl-app-wrapper">
        <asp:ScriptManager runat="server" EnableCdn="false" />

        <!-- Admin Sidebar -->
        <aside class="fl-sidebar" id="flAdminSidebar">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <a class="fl-brand p-0" runat="server" href="~/Admin/Dashboard.aspx">
                        <div class="fl-brand-logo bg-dark text-teal">
                            <i class="bi bi-hexagon-fill"></i>
                        </div>
                        <div>
                            <h1 class="fl-brand-title">FoundrLink</h1>
                            <p class="fl-brand-subtitle">Admin Console</p>
                        </div>
                    </a>
                    <button type="button" class="btn-close d-lg-none" id="btnAdminSidebarClose" aria-label="Close navigation"></button>
                </div>

                <ul class="fl-nav-list mt-3">
                    <li class="fl-nav-item">
                        <a id="navAdminDash" runat="server" href="~/Admin/Dashboard.aspx" class="fl-nav-link">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navAdminUsers" runat="server" href="~/Admin/ManageUsers.aspx" class="fl-nav-link">
                            <i class="bi bi-people-fill"></i>
                            <span>Founders</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navAdminStartups" runat="server" href="~/Admin/ManageStartups.aspx" class="fl-nav-link">
                            <i class="bi bi-briefcase-fill"></i>
                            <span>Startups</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navAdminReports" runat="server" href="~/Admin/Reports.aspx" class="fl-nav-link">
                            <i class="bi bi-flag-fill"></i>
                            <span>Reports & Categories</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Admin Sidebar Footer -->
            <div class="fl-sidebar-footer">
                <ul class="fl-nav-list">
                    <li class="fl-nav-item">
                        <a id="navAdminSettings" runat="server" href="~/Settings.aspx" class="fl-nav-link">
                            <i class="bi bi-gear"></i>
                            <span>Settings</span>
                        </a>
                    </li>
                    <li class="fl-nav-item">
                        <a id="navAdminSupport" runat="server" href="~/Support.aspx" class="fl-nav-link">
                            <i class="bi bi-question-circle"></i>
                            <span>Support</span>
                        </a>
                    </li>
                </ul>

                <div class="fl-user-badge d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                        <asp:Image ID="imgAdminAvatar" runat="server" CssClass="fl-avatar-sm" ImageUrl="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&auto=format&fit=crop&q=80" />
                        <div class="overflow-hidden">
                            <div class="fw-bold text-truncate small">
                                <asp:Literal ID="litAdminName" runat="server" Mode="Encode" Text="System Admin" />
                            </div>
                            <div class="text-muted small" style="font-size: 0.72rem;">Admin Console</div>
                        </div>
                    </div>
                    <asp:LinkButton ID="btnAdminLogout" runat="server" CssClass="text-secondary p-1" OnClick="btnAdminLogout_Click" ToolTip="Log out">
                        <i class="bi bi-box-arrow-right"></i>
                    </asp:LinkButton>
                </div>
            </div>
        </aside>

        <!-- Mobile Admin Sidebar Backdrop Overlay -->
        <div class="fl-sidebar-backdrop d-lg-none" id="flAdminSidebarBackdrop"></div>

        <!-- Admin Main Content -->
        <div class="fl-main-area">
            <!-- Mobile Admin Topbar Header -->
            <header class="fl-topbar d-flex align-items-center justify-content-between d-lg-none px-3">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-link fl-mobile-nav-toggle p-1 text-dark" id="btnAdminSidebarToggle" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-2 lh-1"></i>
                    </button>
                    <span class="fw-bold fs-6 text-dark">Admin Console</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-dark">Admin</span>
                </div>
            </header>

            <!-- Hidden admin topbar controls kept for server-side code-behind compatibility -->
            <div class="d-none">
                <asp:Image ID="imgAdminTopAvatar" runat="server" />
                <asp:Literal ID="litAdminTopName" runat="server" Mode="Encode" />
            </div>

            <main class="fl-content-container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if (typeof bootstrap === 'undefined') {
            document.write('<script src="<%= ResolveClientUrl("~/Scripts/bootstrap.bundle.min.js") %>"><\/script>');
        }
    </script>
    <script src='<%= ResolveClientUrl("~/Scripts/chart.umd.min.js") %>'></script>
    <script>
        (function () {
            var sidebar = document.getElementById('flAdminSidebar');
            var toggleBtn = document.getElementById('btnAdminSidebarToggle');
            var closeBtn = document.getElementById('btnAdminSidebarClose');
            var backdrop = document.getElementById('flAdminSidebarBackdrop');

            function openSidebar() {
                if (sidebar) sidebar.classList.add('show');
                if (backdrop) backdrop.classList.add('show');
                document.body.classList.add('fl-sidebar-open');
            }

            function closeSidebar() {
                if (sidebar) sidebar.classList.remove('show');
                if (backdrop) backdrop.classList.remove('show');
                document.body.classList.remove('fl-sidebar-open');
            }

            if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
            if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
            if (backdrop) backdrop.addEventListener('click', closeSidebar);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && sidebar && sidebar.classList.contains('show')) {
                    closeSidebar();
                }
            });

            if (sidebar) {
                sidebar.querySelectorAll('.fl-nav-link').forEach(function (link) {
                    link.addEventListener('click', function () {
                        if (window.innerWidth < 992) {
                            closeSidebar();
                        }
                    });
                });
            }
        })();
    </script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
